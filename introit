#!/bin/sh
# just install that shit
# repo layout: see docs
# db:   <root>/var/db/introit/installed/<name>/{version,depends,manifest,etcsums}
# apps: one folder each in ~/apps (or <root>/apps). the folder is the install

log() { printf '\033[1m-> %s\033[m %s\n' "$1" "$2"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# curl verifies, wget fallback
get() {
    [ "$repo" ] || die "no repo (set INTROIT_REPO or /etc/introit/repo)"
    case $repo in
        http*) if command -v curl >/dev/null; then curl -fsSL -o "$2" "$repo/$1"
               else wget -qO "$2" "$repo/$1"; fi ;;
        *)     cp "${repo#file://}/$1" "$2" ;;
    esac
}

sync() {
    mkdir -p "$db/repo" && get index "$idx.tmp" && mv "$idx.tmp" "$idx" ||
        die "can't fetch $repo/index"
    log repo Synced
}

pkg() { grep "^$1 " "$idx"; }
ver() { cat "$sysdb/installed/$1/version" "$apps/$1/version" 2>/dev/null | head -n1; }
isapp() { [ "$(pkg "$1" | cut -d' ' -f5)" = app ]; }

# deps first
dep() {
    case " $order " in *" $1 "*) return; esac
    case " $stack " in *" $1 "*) die "dependency cycle:$stack $1"; esac
    set -- "$1" $(pkg "$1")
    [ "$2" ] || die "$1: not in repo"
    stack="$stack $1"
    for d in $(echo "${5:--}" | tr , ' '); do [ "$d" = - ] || dep "$d"; done
    stack=${stack% $1}
    order="$order $1"
}

# no escaping root
check() {
    tar tvf "$1" | awk '
        { p = $NF; if ($1 ~ /^l/) for (i = 1; i <= NF; i++) if ($i == "->") p = $(i-1)
          sub(/^\.\//, "", p); sub(/\/$/, "", p); f[p] = 1; if ($1 ~ /^l/) l[p] = 1 }
        END { for (p in f) {
                if (p ~ /^\// || p ~ /(^|\/)\.\.(\/|$)/) exit 1
                for (s in l) if (index(p, s "/") == 1) exit 1 } }' ||
        die "$2: unsafe path in package"
}

inst() {
    set -- "$1" $(pkg "$1")
    s=$db/stage/$1 t=$db/cache/$1.tar
    rm -rf "$s" && mkdir -p "$s" || die "$1: can't stage"
    lzfse -decode -i "$t.lzfse" -o "$t" || die "$1: bad archive"
    check "$t" "$1"
    tar xf "$t" -C "$s" || die "$1: bad archive"
    (cd "$s" && find . ! -type d | sed 's|^\./||' | sort) > "$s.new"
    sort "$db/installed/$1/manifest" > "$s.old" 2>/dev/null

    while read -r f; do
        o=$(grep -Fxl "$f" "$db"/installed/*/manifest 2>/dev/null | grep -v "/$1/manifest")
        [ "$o" ] && { o=${o%/manifest}; die "/$f is owned by ${o##*/}"; }
        [ -e "$R/$f" ] || [ -h "$R/$f" ] || continue
        grep -Fxq "$f" "$s.old" || die "/$f already exists"
    done < "$s.new"

    # keep edited /etc
    (cd "$s" && grep '^etc/' "$s.new" | while read -r f; do sha256sum "$f"; done) > "$s.sums"
    (cd "$s" && find . -type d) | while read -r d; do mkdir -p "$R/$d"; done
    while read -r f; do
        case $f in etc/*) [ -e "$R/$f" ] && ! (cd "$R" && sha256sum "$f") |
            grep -Fxqf - "$db/installed/$1/etcsums" 2>/dev/null &&
            { mv -f "$s/$f" "$R/$f.new"; log "$1" "Kept /$f, new copy is /$f.new"; continue; }
        esac
        mv -f "$s/$f" "$R/$f" || die "/$f: can't install"
    done < "$s.new"
    grep -Fvx -f "$s.new" "$s.old" | while read -r f; do unlink "$f"; done

    d=$db/installed/$1 && mkdir -p "$d"
    echo "$3" > "$d/version"
    echo "${5:--}" | tr , '\n' | grep -vx - > "$d/depends"
    mv "$s.new" "$d/manifest"
    mv "$s.sums" "$d/etcsums"
    rm -rf "$s" "$s.old" "$t" "$t.lzfse"
    log "$1" "Installed $3"
}

# prune empty dirs
unlink() { (cd "$R" && rm -f "$1" && rmdir -p "${1%/*}") 2>/dev/null; }

add() {
    order= stack= todo=
    for p; do dep "$p"; done
    for p in $order; do
        set -- $(pkg "$p")
        if [ "$(ver "$p")" = "$2" ]; then
            case " $want " in *" $p "*) log "$p" "Already installed ($2)"; esac
        else
            todo="$todo $p"
        fi
    done
    [ "$todo" ] || return 0
    if [ "$R" = / ] && [ "$(id -u)" != 0 ]; then
        sys=; for p in $todo; do isapp "$p" || sys="$sys $p"; done
        [ "$sys" ] && die "needs root first: doas introit a$sys"
    fi

    mkdir -p "$db/cache"
    for p in $todo; do
        set -- $(pkg "$p")
        get "$1@$2.tar.lzfse" "$db/cache/$1.tar.lzfse" &
    done
    wait
    for p in $todo; do
        set -- $(pkg "$p")
        [ -s "$db/cache/$1.tar.lzfse" ] || die "$1: download failed"
        [ "$3" = - ] && continue    # repo didn't ship sums
        sum=$(sha256sum < "$db/cache/$1.tar.lzfse")
        [ "${sum%% *}" = "$3" ] || die "$1: checksum mismatch"
    done
    for p in $todo; do if isapp "$p"; then app "$p"; else inst "$p"; fi; done
}

# an app is one folder. replace it whole
app() {
    t=$db/cache/$1.tar s=$apps/.$1.new
    lzfse -decode -i "$t.lzfse" -o "$t" || die "$1: bad archive"
    check "$t" "$1"
    rm -rf "$s" && mkdir -p "$s" && tar xf "$t" -C "$s" || die "$1: bad archive"
    [ -d "$s/$1" ] || die "$1: not an app"
    rm -rf "${apps:?}/$1" && mv "$s/$1" "$apps/$1" && rm -rf "$s" "$t" "$t.lzfse"
    log "$1" "Installed $(cat "$apps/$1/version") in $apps"
}

del() {
    for p; do
        [ -d "$apps/$p" ] && continue
        [ -d "$db/installed/$p" ] || die "$p: not installed"
        for q in "$db"/installed/*; do
            q=${q##*/}
            case " $* " in *" $q "*) continue; esac
            grep -Fxq "$p" "$db/installed/$q/depends" && log "$p" "Needed by $q, removing anyway"
        done
    done
    for p; do
        [ -d "$apps/$p" ] && { rm -rf "${apps:?}/$p"; log "$p" Removed; continue; }
        sort -r "$db/installed/$p/manifest" | while read -r f; do unlink "$f"; done
        rm -rf "$db/installed/$p"
        log "$p" Removed
    done
}

upd() {
    sync
    stale=
    for d in "$db"/installed/* "$apps"/*; do
        [ -d "$d" ] || continue
        set -- $(pkg "${d##*/}")
        [ "$1" ] && [ "$2" != "$(ver "$1")" ] && stale="$stale $1"
    done
    [ "$stale" ] || { log all "Up to date"; return; }
    want=$stale
    add $stale
}

R=/
[ "$1" = -r ] && { R=$2; shift 2; }
db=$R/var/db/introit idx=$R/var/db/introit/repo/index sysdb=$R/var/db/introit
# root installs for everyone in /apps
if [ "$R" != / ]; then apps=$R/apps; elif [ "$(id -u)" = 0 ]; then apps=${INTROIT_APPS:-/apps}; else apps=${INTROIT_APPS:-$HOME/apps}; fi
# users install apps without root: keep the index and cache in home
[ "$R" = / ] && [ ! -w "$db" ] && [ ! -w "${db%/*}" ] && db=${XDG_CACHE_HOME:-$HOME/.cache}/introit idx=$db/repo/index
repo=${INTROIT_REPO:-$(cat "$R/etc/introit/repo" /etc/introit/repo 2>/dev/null | head -n1)}
cmd=$1
[ "$1" ] && shift

case $cmd in
    a|add)    [ -f "$idx" ] || sync; want=$*; mkdir -p "$apps"; add "$@" ;;
    r|remove) del "$@" ;;
    u|update) upd ;;
    s|search) [ -f "$idx" ] || die "run introit u first"
              cut -d' ' -f1,2 "$idx" | grep -i -- "${1:-.}" ;;
    l|list)   for d in "$db"/installed/* "$apps"/*; do [ -f "$d/version" ] || continue; echo "${d##*/} $(cat "$d/version")"; done ;;
    *) die "usage: introit [-r root] a|r|u|s|l [pkg]..." ;;
esac
